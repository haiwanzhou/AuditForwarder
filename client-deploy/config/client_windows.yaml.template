# AuditForwarder - 跨机器客户端配置模板
# 使用方法：把下面所有 <...> 占位符替换为实际值，然后保存为 client_windows.yaml

agent:
  id: "<本机唯一标识，如 agent-pc-002>"
  data_dir: data/client
  config_path: config/client_windows.yaml

log:
  level: info
  file: data/client/client.log
  max_bytes: 52428800
  max_backups: 5

chain:
  batch_size: 10
  sign_batches: false
  auto_persist: true
  hmac_key: ""                      # 必须与服务端 manager 验签密钥一致（双方为空则跳过验签）

transport:
  servers:
    - "http://<服务端IP>:8443/ingest?agent=<本机唯一标识>"
  mode: realtime
  interval_sec: 5
  compress: true
  encrypt_payload: false
  auth_token: ""                    # 与服务端 manager.auth_token 一致；为空则不鉴权
  verify_tls: false

remote:
  enabled: true
  servers:
    - "http://<服务端IP>:8443"
  host_id: "<本机唯一标识，如 agent-pc-002>"
  heartbeat_interval_sec: 5
  command_poll_interval_sec: 3
  audit_summary_interval_sec: 5
  production_mode: false
  require_tls: false
  crl_check: false
  enrollment_key: ""                # 与服务端 manager.enrollment_key 一致；为空则不鉴权
  allowed_commands:
    - collect_status
    - echo
    - set_collector
    - set_collectors
    - load_rules

detector:
  rules_path: config/rules.yaml
  enable_behavior_baseline: true

self_protect:
  enabled: false

manager:
  enabled: false
  auth_token: ""

collectors:
  enabled: true

# 高权限操作检测：Windows 识别 UAC 提权令牌与 SYSTEM(S-1-5-18)，Linux 识别 uid=0
privilege_detect:
  enabled: true

# 测试注入（生产必须保持 false）
test_injection:
  enabled: false
  interval_ms: 1000

processors:
  - type: enricher
  - type: pii_masker
  - type: deduper
    window_ms: 50
